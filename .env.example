# ─── Nukhba — variables d'environnement ───
# En local : `cp .env.example .env.local` puis remplissez les valeurs.
# Sur Vercel : Settings → Environment Variables (Production), puis redéployez.
# Vérification : `npm run doctor` (ou /api/health après démarrage).
# Ne committez jamais .env / .env.local (déjà dans .gitignore).

# ─── Base de données (Vercel Postgres ou autre) ───
DATABASE_URL=postgresql://…

# ─── Admin ───
ADMIN_PASSWORD=…
SESSION_SECRET=…

# Frais du processeur de paiement, en % — utilisés pour calculer le prix de
# vente depuis la marge nette (admin → Codes & cartes cadeaux).
PAYMENT_FEE_PERCENT=1

# ─── E-mails (optionnel) ───
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
# Expéditeur (domaine vérifié chez Resend/SMTP), ex. :
# Nukhba <no-reply@nokhba.net.ly>
EMAIL_FROM=
# Expéditeur des e-mails (codes livrés, alertes). DOIT être une adresse d'un
# domaine vérifié chez le fournisseur (Resend → Domains, avec SPF/DKIM) :
# sinon l'envoi est accepté puis perdu ou classé en spam.
# Exemple : EMAIL_FROM=Nukhba <no-reply@nokhba.net.ly>
# Domaine de l'expéditeur par défaut si EMAIL_FROM est vide.
EMAIL_DOMAIN=nokhba.net.ly
# Laisser vide/true ; "false" accepte un certificat SMTP auto-signé.
SMTP_TLS_REJECT_UNAUTHORIZED=
# Reçoit les notifications de leads ET de paiements confirmés.
# SANS cette variable, les demandes partent vers l'e-mail public du site :
# si cette boîte n'existe pas, la notification est rejetée (550 5.1.1) et la
# demande est perdue. Mettre une adresse qui reçoit réellement.
LEAD_NOTIFICATION_EMAIL=
# Adresse de réponse des e-mails transactionnels (codes livrés, confirmations).
# L'expéditeur reste no-reply@ (domaine vérifié SPF/DKIM) ; sans cette
# variable, un client qui clique « Répondre » écrit à une boîte inexistante.
EMAIL_REPLY_TO=

# ─── NOWPayments (paiements crypto) ───
# Clé API du marchand : Settings → API keys dans le tableau NOWPayments.
NOWPAYMENTS_API_KEY=
# Secret IPN (Settings → IPN). Optionnel : vaut la clé API par défaut.
NOWPAYMENTS_IPN_SECRET=
# Identifiants du compte — optionnels, servent seulement à
# interroger le statut d'un paiement en direct (polling).
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
# "true" pour tester sur le bac à sable (sandbox) NOWPayments.
# ⚠️ Sandbox et production sont séparés et NON interchangeables : clé de
# production (account.nowpayments.io) → laisser vide/false ; clé sandbox
# (account-sandbox.nowpayments.io) → "true". Un décalage = 403 INVALID_API_KEY.
# Vérification sans paiement : /api/health doit afficher apiKeyValid:true.
NOWPAYMENTS_SANDBOX=
# Optionnel — surcharge de l'URL d'API (tests d'intégration internes
# uniquement ; laisser vide en production).
NOWPAYMENTS_API_BASE=
# Devise de facturation (NOWPayments ne supporte pas la LYD).
NOWPAYMENTS_CURRENCY=usd
# ─── Virements NOWPayments (payouts) ───
# Utilisés UNIQUEMENT par la recharge automatique FazerCards. Un virement
# exige un jeton JWT : NOWPayments_EMAIL / NOWPAYMENTS_PASSWORD ci-dessus sont
# donc obligatoires pour cette fonction (ils restent facultatifs ailleurs).
# Devise envoyée : un ticker NOWPayments, pas un réseau. FazerCards crédite en
# USDT : `usdttrc20` (TRON, minimum de dépôt 10 $) est le choix par défaut.
# Autres valeurs : usdtbsc (BEP20), usdtton (TON), usdt (ERC20, frais élevés).
# NOWPAYMENTS_PAYOUT_CURRENCY=usdttrc20
# Secret TOTP (base32) de la 2FA applicative du compte, si elle est activée
# pour les virements. Le fournir permet de valider un virement SANS saisie
# humaine ; sans lui, un code est envoyé par e-mail et doit être saisi dans
# l'administration sous 1 heure.
# ⚠️ Ce secret vaut un accès aux virements : à ne stocker que dans Vercel.
# NOWPAYMENTS_PAYOUT_TOTP_SECRET=
# ─── Reloadly — livraison des codes à la commande ───
# Tableau de bord : https://dashboard.reloadly.com → Developers → API keys.
# RELOADLY_CLIENT_ID     = valeur « Client ID »     (ex. qwcLz3Xy…)
# RELOADLY_CLIENT_SECRET = valeur « Client Secret » (ex. 7kscVxQZ32-…)
# ⚠️ Pas l'e-mail ni le mot de passe du compte, pas de préfixe « Bearer »,
#    pas de guillemets. Les identifiants TEST et LIVE sont séparés et NON
#    interchangeables. Les clés ne quittent jamais le serveur.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
# Par DÉFAUT le serveur vise le SANDBOX (aucun argent réel dépensé).
# Pour vendre réellement : RELOADLY_SANDBOX=false (avec les clés LIVE).
# ⚠️ Vérifier le solde du compte LIVE avant d'activer : chaque commande
# payée déclenche un achat réel du code.
RELOADLY_SANDBOX=true
# Plafond d'un achat automatique en USD : au-delà, la commande passe en
# livraison manuelle (aucun débit automatique). Défaut : 300.
RELOADLY_MAX_ORDER_USD=300
# Secret de chiffrement des codes livrés (AES-256-GCM). Recommandé et
# distinct de SESSION_SECRET ; à défaut, SESSION_SECRET est utilisé.
DIGITAL_CODES_SECRET=

# URL publique du site — variable serveur (pas de préfixe NEXT_PUBLIC_),
# nécessaire pour les URLs de retour et l'IPN.
# Le domaine canonique se règle aussi depuis /admin → Réglages (champs
# « Domaine affiché » et « URL canonique ») : voir docs/migration-domaine.md.
SITE_URL=https://nokhba.net.ly
# Repli lu par src/lib/site-url.ts si SITE_URL est vide ; préférer SITE_URL.
NEXT_PUBLIC_SITE_URL=

# ─── SEO (optionnel) ───
# Code de vérification Google Search Console (méta-tag).
# Un code par défaut (propriété https://nokhba.net.ly/) est déjà intégré au
# code — cf. googleSiteVerification() dans src/lib/seo.ts — et la
# vérification par fichier (public/googleaf….html) reste active.
# ⚠️ Google n'émet un code que pour une propriété donnée : dès que le
# domaine change, ce code n'est plus valable et le méta-tag n'est plus émis.
# Renseigner cette variable avec le code de la nouvelle propriété.
GOOGLE_SITE_VERIFICATION=

# Clé IndexNow (ping automatique Bing/Yandex à chaque sauvegarde admin).
# Une clé par défaut est déjà intégrée au code et son fichier de preuve est
# dans public/<clé>.txt ; ne renseigner cette variable que pour la remplacer.
# Le ping n'est envoyé qu'en production (VERCEL_ENV=production).
INDEXNOW_KEY=

# ─── Identité du site (badge, audits, citations IA) ───
# Domaine de marque cité dans les réponses des moteurs IA (audit GEO).
# Vide = valeur par défaut du code.
BRAND_DOMAIN=
# Origine reconnue comme badge de netlinking « Website by Nukhba ».
# Vide = déduite de BADGE_BASE_URL / SITE_URL.
BADGE_ORIGIN=
# Anciens domaines tolérés pendant une migration (séparés par des virgules).
# Les pieds de page clients qui pointent encore vers l'ancien domaine restent
# valides au lieu d'être signalés « badge manquant ».
BADGE_ACCEPT=

# ─── Google Search Console (sitemap) — 100 % OPTIONNEL ───
# L'ancien « ping » google.com/ping?sitemap a été retiré par Google (404).
# La soumission passe désormais par l'API Search Console, authentifiée par un
# compte de service Google Cloud (API « Google Search Console API » activée,
# e-mail du compte ajouté dans Search Console → Paramètres → Utilisateurs).
# Laisser les deux variables vides = aucun appel (IndexNow reste actif).
GOOGLE_INDEXING_CLIENT_EMAIL=
# Clé privée PEM du compte de service. Les « \n » littéraux sont acceptés.
GOOGLE_INDEXING_PRIVATE_KEY=
# Propriété Search Console : https://exemple.com/ ou sc-domain:exemple.com
# (vide = dérivée de SITE_URL / du domaine du site).
GOOGLE_INDEXING_SITE_URL=
# "true" pour autoriser l'appel hors déploiement Vercel de production (tests).
GOOGLE_INDEXING_ALLOW_NON_PRODUCTION=

# ─── Assistant SEO IA (/admin → Contenus → Démos) — 100 % OPTIONNEL ───
# Clé API OpenAI. STRICTEMENT optionnelle : sans elle (variable absente ou
# vide localement), le gabarit optimisé est appliqué et l'admin affiche
# « Aucune clé OpenAI configurée » — aucun appel réseau, aucune erreur.
# ⚠️ Vercel refuse une variable d'environnement à valeur vide : pour désactiver
#    l'assistant, SUPPRIMEZ la variable (Settings → Environment Variables →
#    Delete) au lieu de vider son champ ; sinon le déploiement peut échouer ou
#    conserver l'ancienne valeur. Une clé présente mais invalide/expirée, en
#    quota dépassé (401/403/429) ou un timeout de 20 s renvoie `engine:
#    "error"` + un code (`http_401`, `http_429`, `timeout`, `invalid_json`,
#    `empty_response`, `network_error`) et l'admin est invité à corriger la clé.
OPENAI_API_KEY=
# Optionnel — compatible OpenAI (Azure, OpenRouter, Ollama…).
# Défaut : https://api.openai.com/v1
OPENAI_BASE_URL=
# Optionnel — défaut : gpt-4o-mini (doit accepter response_format json_object).
OPENAI_MODEL=

# ─── Chat IA (/api/chat) — Vercel AI Gateway ───
# Clé API de la passerelle Vercel AI Gateway, utilisée par la route
# /api/chat pour appeler Claude (baseURL https://ai-gateway.vercel.sh/v1).
# Sans elle, la route répond 500 (« Une erreur est survenue »).
# Créez la clé dans Vercel → AI Gateway → API Keys, puis ajoutez-la ici
# (local) et dans Settings → Environment Variables (production).
AI_GATEWAY_API_KEY=

# ─── Relances d'abonnement (cron) ───
# Secret du cron Vercel (vercel.json → /api/cron/subscriptions, chaque jour à 08:00 UTC).
# Générez une valeur aléatoire longue. Sans elle, la route refuse de tourner.
CRON_SECRET=

# ─── Divers ───
WEBHOOK_URL=

# ─── FazerCards (fournisseur codes digitaux — remplace Reloadly) ───
# Clé API : https://reseller.fazercards.com → Profile → API key
# Valeur commence par « fc_… ». Ne quitte jamais le serveur.
FAZERCARDS_API_KEY=
# Base URL API (défaut https://api.fzr.cards/api/v2)
FAZERCARDS_API_BASE=https://api.fzr.cards/api/v2
# Plafond d'achat automatique en USD : au-delà, la commande passe en
# livraison manuelle (aucun débit automatique). Défaut : 300.
#
# ⚠️ À garder COHÉRENT avec le solde du compte fournisseur : le solde est
# débité du COÛT fournisseur (~ prix de vente moins la marge). Un plafond plus
# haut que le solde fait encaisser des ventes impossibles à honorer.
# Le cron quotidien /api/cron/fazercards-balance surveille cet écart et
# envoie une alerte interne avec le montant de recharge conseillé.
FAZERCARDS_MAX_ORDER_USD=300
# Délai (heures) avant de répéter une alerte de solde non résolue. Défaut : 24.
# FAZERCARDS_BALANCE_ALERT_RESEND_HOURS=24
# ─── Recharge automatique du solde FazerCards (VIREMENTS RÉELS) ───
# Désactivée par défaut : SANS `true`, aucun virement n'est possible, même
# depuis l'administration. Avant d'activer, lire docs/auto-recharge-fazercards.md.
#
# Principe : quand le solde fournisseur descend sous le float cible (coût du
# plafond de vente + 15 %) d'un montant supérieur au seuil, une facture de
# dépôt est créée chez FazerCards puis payée par un virement USDT depuis le
# solde custody NOWPayments. Un seul virement à la fois ; le cron planifié ne
# fait qu'une simulation (l'exécution réelle exige `?execute=1`).
FAZERCARDS_AUTOTOPUP_ENABLED=false
# Écart minimal avec le float cible avant de déclencher un virement (USD).
# En dessous de ~50 $, les frais réseau fixes pèsent trop sur la marge.
# FAZERCARDS_AUTOTOPUP_THRESHOLD_USD=50
# Plafond d'un virement (USD). Le float cible reste la vraie limite.
# FAZERCARDS_AUTOTOPUP_MAX_USD=300
# Frais réseau tolérés, en proportion du montant (0.03 = 3 %). Au-delà, le
# virement est reporté au passage suivant.
# FAZERCARDS_AUTOTOPUP_MAX_FEE_RATIO=0.03
# Méthode de dépôt FazerCards (trc20, bep20, ton, aptos, binancepay). Doit
# correspondre à la devise du virement ci-dessous.
# FAZERCARDS_AUTOTOPUP_METHOD=trc20
# Montant minimal d'une facture crypto (USD). Le catalogue contient des
# articles à 0,81 $ : la caisse impose la quantité nécessaire pour atteindre
# ce minimum (valeurs typiques : 1 à 3 $ selon la cryptomonnaie). Défaut : 1.5.
FAZERCARDS_MIN_ORDER_USD=1.5
# Secret webhook FazerCards — laisser VIDE (et ne pas créer la variable sur
# Vercel, qui refuse une valeur vide). À remplir seulement si un webhook de
# statut est réellement déclaré dans le hub revendeur.
FAZERCARDS_WEBHOOK_SECRET=
# Cache du catalogue (mémoire, par instance) : durée de fraîcheur en secondes.
# Le catalogue coûte un appel HTTP par catégorie ; 600 s (10 min) est un bon
# compromis prix / charge. 0 = aucune mise en cache (déconseillé en prod).
FAZERCARDS_CATALOG_TTL_SECONDS=600
# Âge maximal d'un catalogue périmé encore servi si le rafraîchissement
# échoue (panne ou 429 du fournisseur) : mieux vaut vendre au prix connu
# que refuser la vente. Défaut : 60 minutes.
FAZERCARDS_CATALOG_MAX_STALE_MINUTES=60
# Plafond de catégories DÉTAILLÉES par famille et par synchro (top-ups,
# cartes, clés). Chaque catégorie coûte un appel HTTP : ce plafond borne le
# temps d'exécution serverless. Les catégories non détaillées ne sont PAS
# perdues : elles passent à la synchro suivante (rotation) et le catalogue
# déjà synchronisé est fusionné. 1–400. Défaut : 80.
FAZERCARDS_CATALOG_MAX_CATEGORIES=80
# Taille d'une page de liste lue chez le fournisseur (max 100).
FAZERCARDS_CATALOG_PAGE_SIZE=100
# Nombre maximal de pages de liste par famille (100 catégories par page).
# 10 pages = jusqu'à 1000 catégories listées par famille.
FAZERCARDS_CATALOG_MAX_PAGES=10
# Budget de temps d'une synchronisation (ms). Au-delà, les détails restants
# sont reportés à la synchro suivante au lieu de faire expirer la fonction.
FAZERCARDS_CATALOG_TIME_BUDGET_MS=25000
# Âge maximal (jours) d'une fiche conservée par fusion : au-delà, elle est
# retirée de la vitrine pour ne pas vendre un prix périmé. 0 = illimité.
FAZERCARDS_CATALOG_MAX_PRODUCT_AGE_DAYS=7
# Taille maximale du catalogue fusionné (garde-fou base/mémoire).
FAZERCARDS_CATALOG_MAX_PRODUCTS=2000
# Requêtes simultanées vers l'API (1–12). Plus haut = synchro plus rapide,
# mais risque de 429 si le compte est limité. Défaut : 6.
FAZERCARDS_CATALOG_CONCURRENCY=6
